shell.handler({

    'create' : {

        'table' : lambda self,verb,noun,cmnd : print(f"{verb} {noun} : {cmnd}"),
        '*'     : lambda self,verb,noun,cmnd : print(f"{verb} *({noun}) : {cmnd}")

    }

})

